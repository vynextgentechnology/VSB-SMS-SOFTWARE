# GEMINI_API_KEY: Required for Google Gemini AI API calls (gemini-3.6-flash).
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# MONGODB_URI: Connection string for permanent MongoDB database storage
# Example: mongodb://localhost:27017/college_sms_db or mongodb+srv://user:pass@cluster.mongodb.net/college_sms_db
MONGODB_URI="mongodb://localhost:27017/college_sms_db"

# JWT_SECRET: Secret key for signing and verifying role-based authentication tokens
JWT_SECRET="VSB_ENGINEERING_COLLEGE_SECRET_KEY_2026"

# PORT: Port where Express server runs (3000)
PORT=3000

# FAST2SMS_API_KEY: Single Fast2SMS API Key for real-time transactional SMS
FAST2SMS_API_KEY=""

# FAST2SMS_API_KEYS: Comma-separated list of 5–10 Fast2SMS API keys for automatic key rotation
# Example: FAST2SMS_API_KEYS="key_alpha_1,key_beta_2,key_gamma_3,key_delta_4,key_epsilon_5"
FAST2SMS_API_KEYS=""

# FAST2SMS_API_KEY_1 through FAST2SMS_API_KEY_10: Individual key slots for automatic rotation
FAST2SMS_API_KEY_1=""
FAST2SMS_API_KEY_2=""
FAST2SMS_API_KEY_3=""
FAST2SMS_API_KEY_4=""
FAST2SMS_API_KEY_5=""

# TWILIO_ACCOUNT_SID & AUTH_TOKEN: Optional Twilio SMS configuration
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
